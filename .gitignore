
# World-map PNGs are committed (needed by Kopernicus MapSODemand on-disk loader)
# DDS files are NOT committed — they conflict with Kopernicus OnDemandStorage
# and cause "does not exist on disk" errors. PNGs only; Unity re-compresses at load time.
GameData/ProjectHailMary/Textures/*.dds
GameData/ProjectHailMary/Textures/EVE/*.dds
GameData/ProjectHailMary/Textures/Parallax/*.dds

# Terrain texture source PNGs (generated by Tools/generate_terrain_textures.py)
Tools/terrain_src/

# KSP cache
GameData/Kopernicus/Cache/

# C# build artifacts — obj/ folder is MSBuild intermediate output, never commit
GameData/ProjectHailMary/Plugins/Source/obj/
